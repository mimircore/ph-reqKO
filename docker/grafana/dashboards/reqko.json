{
  "uid": "reqko-overview",
  "title": "ph-reqKO overview",
  "tags": ["ph-reqko", "dns"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Resolver up",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "up{job=\"reqko\"}" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP" }, "0": { "text": "DOWN" } } }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active rules",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "dns_active_rules_count{job=\"reqko\"}" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "QPS (1m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(dns_queries_total[1m]))" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Blocked % (1m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(dns_blocked_queries_total[1m])) / clamp_min(sum(rate(dns_queries_total[1m])), 0.001)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Cache hit ratio (5m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(dns_cache_hits_total[5m])) / clamp_min(sum(rate(dns_cache_hits_total[5m])) + sum(rate(dns_cache_misses_total[5m])), 0.001)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1 }, "overrides": [] }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "QPS by protocol",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (protocol) (rate(dns_queries_total[1m]))",
          "legendFormat": "{{protocol}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Latency p50/p95/p99 per class",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, class) (rate(dns_query_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{class}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, class) (rate(dns_query_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{class}}"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, class) (rate(dns_query_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 {{class}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Blocked queries by reason",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(dns_blocked_queries_total[5m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Dropped query-log events (queue full)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(dns_dropped_logs_total[5m]))" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Resolver resident memory",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        { "refId": "A", "expr": "process_resident_memory_bytes{job=\"reqko\"}" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "id": 15,
      "type": "piechart",
      "title": "Cache hit vs miss (5m rate)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(dns_cache_hits_total[5m]))", "legendFormat": "hits" },
        { "refId": "B", "expr": "sum(rate(dns_cache_misses_total[5m]))", "legendFormat": "misses" }
      ]
    }
  ]
}
